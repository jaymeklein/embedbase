# ─── Required ─────────────────────────────────────────────────────────────────
# The ONLY application secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Also the seed for the console login-session (JWT) signing key — there is no
# separate session secret; rotating this invalidates every active login session.
MASTER_API_KEY=

# ─── Deploy / bootstrap ───────────────────────────────────────────────────────
# Everything else that used to live here — embedding provider/model, vector store
# backend + connection, parsers/GPU, search, MCP, file-size limit — is now
# application config, owned by config.yaml and editable in the Settings → Config
# page (live reload). Only deployment/bootstrap values that must exist before the
# app can start remain below.

# Infrastructure (Celery broker + relational DB) — needed before the app boots.
REDIS_URL=redis://redis:6379/0
DATABASE_PATH=/store/embedbase.db
# DATABASE_URL overrides DATABASE_PATH with a full SQLAlchemy URL (e.g.
# postgresql+psycopg://user:pass@host:5432/db); docker-compose.yml sets this
# to the bundled postgres container. Unset -> SQLite at DATABASE_PATH.
# DATABASE_URL=

# Middleware / process — applied at API/worker startup.
LOG_LEVEL=info                             # debug | info | warning | error
LOG_FORMAT=json                            # json | text
CELERY_CONCURRENCY=2
# Browser origins allowed to call the API (comma-separated). List every address the
# console is opened at; for multi-machine LAN access add the host's LAN IP too, so the
# cross-origin presigned file download (browser → MinIO) passes CORS — e.g.
# http://localhost:3000,http://192.168.x.x:3000
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_SECONDS=43200                  # console login-session (JWT) lifetime; default 12h
EMBEDBASE_SECURE_HEADERS=false             # set true for shared-network deployments

# Your machine's LAN IP (private address, e.g. 192.168.x.x) that other devices
# use to reach the MCP server. A bridge-networked container can't detect the
# host's LAN IP, so set it here to advertise a reachable address; left blank, the
# app falls back to in-container socket detection.
# LAN_HOST=192.168.3.33

# ─── Host-exposed ports (docker-compose only — not read by the app) ───────────
# Map host ports → container ports in docker-compose.yml. Change if the defaults
# conflict. Run `python scripts/check_ports.py` to detect conflicts.
API_PORT=8000                              # host port → API container (internal 8000)
UI_PORT=3000                               # host port → nginx/UI container (internal 80)
POSTGRES_HOST_PORT=5432                    # host port → postgres (127.0.0.1 only; for a DB GUI)

# ─── Postgres (vector store + relational metadata) ────────────────────────────
# docker-compose.yml sets POSTGRES_HOST/PORT/DB/USER for the postgres container
# and derives DATABASE_URL from them; only the password needs setting here.
POSTGRES_PASSWORD=

# ─── Object storage (optional; default is local disk) ─────────────────────────
# The default stack stores uploads on a local volume — nothing here is needed.
# To use S3/MinIO: declare the backend in config.yaml, then set its secrets here.
# STORAGE_DEFAULT overrides storage.default; per-instance vars are named
# S3__<UPPERCASE_BACKEND_NAME>__<KEY>.
# STORAGE_DEFAULT=minio

# Bundled MinIO (docker-compose.minio.yml). The access key/secret double as the
# MinIO root user/password, so set the secret (>=8 chars) before starting.
# S3__MINIO__ACCESS_KEY_ID=embedbase
# S3__MINIO__SECRET_ACCESS_KEY=
# Browser-facing endpoint the presigned upload/download URLs are signed against
# (overrides public_endpoint_url in config.yaml). Default localhost:9000 resolves only on
# the server host; for the console used from OTHER machines set the host LAN IP (matching
# LAN_HOST), e.g. http://192.168.x.x:9000 — and add that origin to CORS_ORIGINS above.
# S3__MINIO__PUBLIC_ENDPOINT_URL=http://localhost:9000
# MINIO_PORT=9000                            # host port → MinIO S3 API (presigned-URL host)
# MINIO_CONSOLE_PORT=9001                    # host port → MinIO web console

# External AWS S3 (no container — just config.yaml + these secrets).
# S3__AWS__ACCESS_KEY_ID=
# S3__AWS__SECRET_ACCESS_KEY=
